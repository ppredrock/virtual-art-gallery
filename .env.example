# Leave TURSO_* empty to use a local SQLite file (local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 32+ characters
SESSION_SECRET=

# Used by `npm run db:seed`
ADMIN_EMAIL=admin@gallery.local
ADMIN_PASSWORD=

# Optional: enables image upload in the admin. Without it, paste an image URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
